{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/agents-md-review.py\"",
            "timeout": 300,
            "statusMessage": "Reviewing AGENTS.md against this session's diff"
          }
        ]
      }
    ]
  }
}
